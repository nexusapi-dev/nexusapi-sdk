{
  "name": "nexusapi-sdk",
  "version": "0.5.0",
  "description": "Node.js / TypeScript SDK for NexusAPI — video, image and text models through a single API (Veo, Kling, Seedance, Nano-Banana, Claude, GPT). OpenAI-compatible /v1 with streaming. Auto-retries, auto idempotency.",
  "keywords": [
    "ai",
    "video",
    "image",
    "generation",
    "veo",
    "kling",
    "seedance",
    "nano-banana",
    "llm",
    "chat",
    "claude",
    "gpt",
    "sora",
    "openai-compatible",
    "idempotency-key",
    "nexusapi"
  ],
  "homepage": "https://docs.nexusapi.dev/sdks/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nexusapi-dev/nexusapi-sdk.git",
    "directory": "node"
  },
  "bugs": {
    "url": "https://github.com/nexusapi-dev/nexusapi-sdk/issues"
  },
  "author": {
    "name": "NexusAPI",
    "email": "support@nexusapi.dev",
    "url": "https://docs.nexusapi.dev"
  },
  "license": "MIT",
  "type": "module",
  "main": "./dist/cjs/index.js",
  "module": "./dist/index.js",
  "types": "./dist/cjs/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./package.json": "./package.json"
  },
  "sideEffects": false,
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.json && tsc -p tsconfig.cjs.json && node -e \"require('fs').writeFileSync('dist/cjs/package.json', JSON.stringify({type: 'commonjs'}) + '\\n')\"",
    "prepublishOnly": "npm run build",
    "typecheck": "tsc --noEmit",
    "test": "npm run build && node --test tests/*.test.js tests/*.test.cjs",
    "examples:check": "tsc -p tsconfig.examples.json"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "typescript": "^5.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
